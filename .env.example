# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=use-a-long-random-string

# First-run accounts (only used when the database has none yet)
ADMIN_EMAIL=admin@yourschool.example
ADMIN_PASSWORD=change-me
SUPERADMIN_USER=nexkido
SUPERADMIN_PASSWORD=change-me

# --- Browser notifications when the app is closed (Web Push) ---
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.example

# --- Maps (all optional; the defaults are free and need no key) ---
# Road route + traffic-aware ETA from Google (enable the "Routes API" on the key). Without it, OSRM on OpenStreetMap is used.
GOOGLE_MAPS_API_KEY=
# Your own OSRM server for production use (the public demo server is rate limited)
OSRM_URL=
# Any MapLibre style JSON (MapTiler, Stadia, a self-hosted style...). Default: OpenFreeMap "Liberty".
NEXT_PUBLIC_MAP_STYLE_URL=
